{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_memory.schema.json",
  "title": "Visual memory record",
  "type": "object",
  "required": [
    "schema_version",
    "path",
    "source_name",
    "content_sha256",
    "source_mtime_ns",
    "analysed_at",
    "model",
    "profile",
    "analysis_max_dimension",
    "data_class",
    "analysis",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "path": {"type": "string"},
    "source_name": {"type": "string"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_mtime_ns": {"type": "integer"},
    "analysed_at": {"type": "string", "format": "date-time"},
    "model": {"type": "string"},
    "profile": {"enum": ["background", "overnight"]},
    "analysis_max_dimension": {"type": "integer"},
    "data_class": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "CLIENT_RESTRICTED"]},
    "analysis": {
      "type": "object",
      "required": ["summary", "subjects", "setting", "composition", "visual_style", "lighting", "dominant_colors", "readable_text", "useful_for", "tags", "confidence", "warnings"],
      "properties": {
        "summary": {"type": "string"},
        "subjects": {"type": "array", "items": {"type": "string"}},
        "setting": {"type": "string"},
        "composition": {"type": "string"},
        "visual_style": {"type": "string"},
        "lighting": {"type": "string"},
        "dominant_colors": {"type": "array", "items": {"type": "string"}},
        "readable_text": {"type": "array", "items": {"type": "string"}},
        "useful_for": {"type": "array", "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metrics": {"type": "object"}
  }
}
